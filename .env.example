APP_NAME="Student Information System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8765
SECURITY_SALT=replace-this-with-a-long-random-secret

# For Neon, use DATABASE_URL and keep sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Or configure the local / HelioHost PostgreSQL database:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=student_information_system
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer
