{
  "name": "portfolio/cakephp-student-information-system",
  "description": "A beginner-friendly Student Information System built with CakePHP 5 and JSON file storage.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "cakephp/cakephp": "^5.2",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "App\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "App\\Test\\": "tests/" }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
