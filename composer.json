{
  "name": "portfolio/cakephp-student-information-system",
  "description": "A beginner-friendly Student Information System built with CakePHP 5 and PostgreSQL.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "cakephp/cakephp": "^5.2",
    "cakephp/migrations": "^4.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Test\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php bin/cake.php plugin load Migrations"
    ],
    "post-update-cmd": [
      "@php bin/cake.php plugin load Migrations"
    ]
  },
  "config": {
    "allow-plugins": {
      "cakephp/plugin-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
